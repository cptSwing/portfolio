---
import PageShell from '../../layouts/PageShell.astro';
import { clientRequest } from '../../api/graphqlClient.ts';
import { GetPostDocument, GetAllPostsSlugsDocument } from '../../api/gql/graphql.ts';

export async function getStaticPaths() {
    const res = await clientRequest(GetAllPostsSlugsDocument);
    return res.posts?.nodes.map((post) => ({
        params: { slug: post.slug },
    }));
}

const { slug } = Astro.params;
const { post } = await clientRequest(GetPostDocument, { slug });
---

<PageShell pageTitle={slug ?? ''}>
    <h1 set:html={post?.title} class="text-4xl font-bold" />
    <div class="prose mt-8" set:html={post?.content} />
</PageShell>
