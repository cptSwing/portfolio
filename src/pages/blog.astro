---
import PageShell from '../layouts/PageShell.astro';
import { clientRequest } from '../api/graphqlRequestClient.ts';
import { GetAllPostsSlugsTitlesCategoriesFeaturedImagesDocument } from '@graphql-generated';
import { Picture } from 'astro:assets';

const data = await clientRequest(GetAllPostsSlugsTitlesCategoriesFeaturedImagesDocument);
const posts = data.posts?.nodes;
---

<PageShell title="Blog">
    <h1 class="text-3xl font-bold">Blog</h1>
    <ul class="space-y-4 mt-6">
        {
            posts &&
                posts.map(
                    (post) =>
                        post.categories && (
                            <li>
                                {post.featuredImage?.node.sourceUrl ?
                                    <Picture
                                        class="object-cover aspect-square inline-block"
                                        alt=""
                                        src={post.featuredImage.node.sourceUrl}
                                        formats={['webp']}
                                        width={200}
                                        height={200}
                                        decoding="async"
                                        loading="lazy"
                                    />
                                :   <div class="inline-block size-[200px] bg-gray-200" />}
                                <a class="text-xl text-blue-600 hover:underline" href={`/${post.categories.nodes[0].slug}/${post.slug}/`}>
                                    {post.title}
                                </a>
                            </li>
                        )
                )
        }
    </ul>
</PageShell>
