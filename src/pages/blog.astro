---
import PageShell from '../layouts/PageShell.astro';
import { clientRequest } from '../api/graphqlClient.ts';
import { GetAllPostsTitlesSlugsDocument } from '../api/gql/graphql.ts';

const data = await clientRequest(GetAllPostsTitlesSlugsDocument);
const posts = data.posts?.nodes;
---

<PageShell pageTitle="Blog">
    <h1 class="text-3xl font-bold">Blog</h1>
    <ul class="space-y-4 mt-6">
        {
            posts &&
                posts.map((post) => (
                    <li>
                        <a class="text-xl text-blue-600 hover:underline" href={`/categories/${post.slug}/`}>
                            {post.title}
                        </a>
                        {/* {post.acf?.subtitle && <p class="text-gray-500">{post.acf.subtitle}</p>} */}
                    </li>
                ))
        }
    </ul>
</PageShell>
