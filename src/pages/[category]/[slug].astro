---
import PageShell from '../../layouts/PageShell.astro';
import { clientRequest } from '../../api/graphqlRequestClient.ts';
import { GetAllPostsComprehensiveDocument } from '@graphql-generated';

export async function getStaticPaths() {
    const res = await clientRequest(GetAllPostsComprehensiveDocument);

    if (!res.posts) {
        return null;
    } else {
        return res.posts.nodes.map((post) => ({
            params: { slug: post.slug, category: post.categories?.nodes[0].slug },
            props: { title: post.title, content: post.content },
        }));
    }
}

const { slug } = Astro.params;
const { title, content } = Astro.props;
---

{
    slug && (
        <PageShell title={title}>
            <h1 set:html={title} class="text-4xl font-bold" />
            <Fragment set:html={content} />
        </PageShell>
    )
}
