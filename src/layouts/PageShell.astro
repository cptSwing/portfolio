---
import '../styles/global.css';
import Head from '../components/Head.astro';

interface Props {
    title: string | null;
}

const { title } = Astro.props;
---

<html lang="en">
    <Head title={title} />

    <body class="flex h-screen w-screen flex-col items-center justify-center bg-theme-background font-teko">
        <slot />
    </body>
</html>
