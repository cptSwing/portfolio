---
import '../styles/global.css';
import Head from '../components/Head.astro';

interface Props {
    pageTitle: string;
}

const { pageTitle } = Astro.props;
---

<html lang="en">
    <Head pageTitle={pageTitle} />

    <body class="flex h-screen w-screen flex-col items-center justify-center">
        <slot />
    </body>
</html>
