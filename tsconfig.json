{
    "extends": "astro/tsconfigs/strict",
    "include": [".astro/types.d.ts", "src/**/*", "eslint.config.ts"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "allowImportingTsExtensions": true,
        // "noEmit": true, // needed for the above to work?
        "moduleResolution": "node16",
        "module": "node16"
    }
}
