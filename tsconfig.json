{
    "extends": "astro/tsconfigs/strict",
    "include": ["**/*", ".astro/types.d.ts", "eslint.config.ts"],
    "exclude": ["dist", ".vscode"],
    "compilerOptions": {
        "target": "es2023",
        "jsx": "react-jsx",
        "jsxImportSource": "preact",
        "allowImportingTsExtensions": true,
        "noEmit": true,
        "moduleResolution": "node16",
        "module": "node16"
        // "noUnusedLocals": false,
        // "noUnusedParameters": false
    }
}
