{
    "name": "portfolio",
    "type": "module",
    "version": "0.0.1",
    "license": "MIT",
    "private": true,
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "lint": "eslint --fix .",
        "format": "prettier --write --log-level silent .",
        "lint-and-format": "yarn lint && yarn format",
        "generate-codegen": "rm -rf ./src/api/graphqlGenerated && graphql-codegen-esm --config ./graphqlConfig/codegen.ts",
        "check-codegen": "echo 'Checking if generated GraphQL Types are up-to-date' && graphql-codegen-esm --check --config ./graphqlConfig/codegen.ts",
        "test-eslint": "vitest run --dir ./tests",
        "predev": "yarn check-codegen || (echo 'Need to regenerate GraphQL Types!' && yarn generate-codegen)",
        "prebuild": "rm -rf ./dist && yarn generate-codegen && yarn lint-and-format"
    },
    "dependencies": {
        "@astrojs/preact": "^5.1.1",
        "@tailwindcss/vite": "^4.2.2",
        "astro": "^6.1.5",
        "preact": "^10.29.1",
        "tailwindcss": "^4.2.2"
    },
    "devDependencies": {
        "@eslint/css": "^1.1.0",
        "@graphql-codegen/cli": "6.3.0",
        "astro-purgecss": "^6.0.1",
        "astro-show-tailwindcss-breakpoint": "^2.0.0",
        "eslint": "^10.2.0",
        "eslint-config-preact": "^2.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^1.7.0",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "graphql": "^16.13.2",
        "graphql-request": "^7.4.0",
        "prettier": "^3.8.2",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "purgecss": "^8.0.0",
        "tailwind-csstree": "^0.3.1",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vitest": "^4.1.4"
    }
}
